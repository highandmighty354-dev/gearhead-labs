  ]
 },
 "bearing_life": {
  "fields": [
   {
    "id": "load_br",
    "tag": "INPUT",
    "label": "Equivalent Dynamic Load",
    "value": "2000"
   },
   {
    "id": "rated_load",
    "tag": "INPUT",
    "label": "Bearing Dynamic Load Rating",
    "value": "5000"
   },
   {
    "id": "rpm_br",
    "tag": "INPUT",
    "label": "Operating Speed↓ use 2800",
    "value": "3000"
   },
   {
    "id": "life_exp",
    "tag": "SELECT",
    "label": "Bearing Type",
    "value": "3",
    "options": [
     {
      "value": "3",
      "label": "Ball Bearing (p=3)"
     },
     {
      "value": "3.33",
      "label": "Roller Bearing (p=10/3)"
     }
    ]
   }
  ],
  "reg": {
   "registry": "GH_BACKFILL_FORMULAS",
   "spec": {
    "labels": [
     "Equivalent Dynamic Load",
     "Bearing Dynamic Load Rating",
     "Operating Speed"
    ],
    "vars": [
     "load_br",
     "rated_load",
     "rpm_br"
    ],
    "outputs": [
     {
      "expr": "Math.pow(rated_load/load_br,3)",
      "out": "L10 Life (ball bearing, p=3)",
      "unit": "million rev"
     },
     {
      "expr": "Math.pow(rated_load/load_br,3)*1000000/(rpm_br*60)",
      "out": "L10 Life (hours)",
      "unit": "hours"
     }
    ]
   }
  },
  "results": [
   "L10 Life",
   "L10 Life (hours)",
   "L10 Life (days @ 24hr)"
  ]
 }
}