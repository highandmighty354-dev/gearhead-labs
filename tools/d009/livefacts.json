 "ring_gap": {
  "fields": [
   {
    "id": "bore_rg",
    "tag": "INPUT",
    "label": "Bore↓ use 4.21",
    "value": "4.25"
   },
   {
    "id": "app_rg",
    "tag": "SELECT",
    "label": "Application",
    "value": "street",
    "options": [
     {
      "value": "street",
      "label": "Street / Moderate Performance"
     },
     {
      "value": "na_race",
      "label": "Race / Naturally Aspirated"
     },
     {
      "value": "nitrous_street",
      "label": "Nitrous — Street"
     },
     {
      "value": "nitrous_race",
      "label": "Nitrous — Race"
     },
     {
      "value": "boost",
      "label": "Turbo / Supercharged"
     }
    ]
   }
  ],
  "reg": {
   "registry": "GH_BACKFILL_FORMULAS",
   "spec": {
    "labels": [
     "Bore"
    ],
    "vars": [
     "bore_rg"
    ],
    "outputs": [
     {
      "expr": "bore_rg*0.0045",
      "out": "Top Ring Gap (Street)",
      "unit": "in"
     },
     {
      "expr": "bore_rg*0.0048",
