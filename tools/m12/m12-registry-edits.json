{
 "weight_reduction": {
  "registries": 1,
  "note": "live: gain = (finite && newWt>0) ? ... : NaN",
  "before": {
   "labels": [
    "Current Horsepower",
    "Current Vehicle Weight",
    "Weight to Remove"
   ],
   "vars": [
    "hp3",
    "wt3",
    "red"
   ],
   "expr": "hp3*(red/(wt3-red))",
   "out": "Equivalent HP Gain",
   "unit": "HP"
  },
  "after": {
   "labels": [
    "Current Horsepower",
    "Current Vehicle Weight",
    "Weight to Remove"
   ],
   "vars": [
    "hp3",
    "wt3",
    "red"
   ],
   "expr": "([hp3,wt3,red].every(Number.isFinite)&&(wt3-red)>0) ? (hp3*(red/(wt3-red))) : NaN",
   "out": "Equivalent HP Gain",
   "unit": "HP"
  }
 },
 "static_compression": {
  "registries": 1,
  "note": "live: invalid box for all outputs unless valid",
  "before": {
   "labels": [
    "Bore",
    "Stroke",
    "Chamber Volume",
    "Head Gasket Volume",
    "Piston Volume (+dome / −dish)"
   ],
   "vars": [
    "bore2",
    "stroke2",
    "chamber",
    "gasket",
    "piston"
   ],
   "outputs": [
    {
     "expr": "((Math.PI/4)*Math.pow(bore2,2)*stroke2)*16.387064",
     "out": "Swept Volume",
     "unit": "cc"
    },
    {
     "expr": "chamber+gasket-piston",
     "out": "Clearance Volume",
     "unit": "cc"
    },
    {
     "expr": "(bore2>0&&stroke2>0&&chamber>=0&&gasket>=0&&(chamber+gasket-piston)>0)?+(((((Math.PI/4)*Math.pow(bore2,2)*stroke2)*16.387064)+(chamber+gasket-piston))/(chamber+gasket-piston)).toFixed(3):0",
     "out": "Static Compression Ratio",
     "unit": ":1"
    }
   ]
  },
  "after": {
   "labels": [
    "Bore",
    "Stroke",
    "Chamber Volume",
    "Head Gasket Volume",
    "Piston Volume (+dome / −dish)"
   ],
   "vars": [
    "bore2",
    "stroke2",
    "chamber",
    "gasket",
    "piston"
   ],
   "outputs": [
    {
     "expr": "(bore2>0&&stroke2>0&&chamber>=0&&gasket>=0&&(chamber+gasket-piston)>0) ? (((Math.PI/4)*Math.pow(bore2,2)*stroke2)*16.387064) : NaN",
     "out": "Swept Volume",
     "unit": "cc"
    },
    {
     "expr": "(bore2>0&&stroke2>0&&chamber>=0&&gasket>=0&&(chamber+gasket-piston)>0) ? (chamber+gasket-piston) : NaN",
     "out": "Clearance Volume",
     "unit": "cc"
    },
    {
     "expr": "(bore2>0&&stroke2>0&&chamber>=0&&gasket>=0&&(chamber+gasket-piston)>0) ? ((bore2>0&&stroke2>0&&chamber>=0&&gasket>=0&&(chamber+gasket-piston)>0)?+(((((Math.PI/4)*Math.pow(bore2,2)*stroke2)*16.387064)+(chamber+gasket-piston))/(chamber+gasket-piston)).toFixed(3):0) : NaN",
     "out": "Static Compression Ratio",
     "unit": ":1"
    }
   ]
  }
 },
